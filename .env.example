# 本文件保存应用运行配置；真实密钥仅放在本机 .env 中，不要提交到版本库或粘贴到聊天中。

# 应用配置
APP_NAME=OnCall Aegnt
DEBUG=True
HOST=0.0.0.0
PORT=9900

# 千问平台配置
QWEN_API_KEY=
QWEN_API_BASE=https://maas.qianwenaiapi.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen3.8-max
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
QWEN_EMBEDDING_DIMENSIONS=1024

# Milvus 配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000

# RAG 检索与存储配置
RAG_COLLECTION_NAME=oncall_knowledge_children
RAG_STORAGE_PATH=data/knowledge
RAG_TOP_K=3

# 文档分块配置
RAG_PARENT_CHUNK_SIZE=1600
RAG_CHILD_CHUNK_SIZE=400
RAG_CHILD_CHUNK_OVERLAP=80
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# MCP 服务配置
# 默认将以下内置本机地址转为框架托管的 stdio，无需手动启动 MCP。
# 外部 HTTP 地址保持不变；由容器/进程管理器部署远程服务。
MCP_AUTO_START=true
MCP_DISCOVERY_TIMEOUT=10
MCP_TOOL_TIMEOUT=30
MCP_REFRESH_INTERVAL=30
# 关闭 AUTO_START 后保留 HTTP 连接；显式设置 stdio 仍使用本地自动进程。
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp

# LangSmith 追踪配置；默认关闭，启用后填写对应 API Key。
# endpoint 应匹配账号所属区域；下面保留输入输出以便观察完整检索链路。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=OncallAgent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
