# 本文件保存应用运行配置；真实密钥仅放在本机 .env 中，不要提交到版本库或粘贴到聊天中。

# 应用配置
APP_NAME=OnCall Aegnt
DEBUG=True
HOST=0.0.0.0
PORT=9900

# 千问平台配置
QWEN_API_KEY=
QWEN_API_BASE=https://maas.qianwenaiapi.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen3.8-max
SUPERVISOR_MODEL=qwen3.8-flash
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
QWEN_EMBEDDING_DIMENSIONS=1024
QWEN_RERANK_MODEL=qwen3.7-text-rerank
QWEN_RERANK_URL=https://maas.qianwenaiapi.com/api/v1/services/rerank/text-rerank/text-rerank
QWEN_RERANK_TIMEOUT=20

# 联网搜索配置 (Tavily Search API)
# 注册 tavily.com 获取免费 API Key，每月 1,000 次免费请求
TAVILY_API_KEY=
TAVILY_API_BASE=https://api.tavily.com
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=15.0

# Milvus 配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000

# RAG 检索与存储配置
RAG_COLLECTION_NAME=oncall_knowledge_children
RAG_STORAGE_PATH=data/knowledge
RAG_TOP_K=3
# 有历史才消歧，失败使用原 query；无历史跳过生成。
RAG_QUERY_REWRITE_ENABLED=true
RAG_QUERY_REWRITE_TIMEOUT=20
RAG_HISTORY_MAX_MESSAGES=20
RAG_HISTORY_MAX_CHARS=32000
# 重排复用 QWEN_API_KEY；启用 API 精排后可按需开启 HyDE。
RAG_HYDE_ENABLED=false
RAG_HYDE_TIMEOUT=20
RAG_RERANK_ENABLED=false
RAG_RERANK_TOP_N=3
# 原始分数阈值默认不设置；不是概率。

# 文档分块配置
RAG_PARENT_CHUNK_SIZE=1600
RAG_CHILD_CHUNK_SIZE=400
RAG_CHILD_CHUNK_OVERLAP=80
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# MCP 服务配置
# 默认将以下内置本机地址转为框架托管的 stdio，无需手动启动 MCP。
# 外部 HTTP 地址保持不变；由容器/进程管理器部署远程服务。
MCP_AUTO_START=true
MCP_DISCOVERY_TIMEOUT=10
MCP_TOOL_TIMEOUT=30
MCP_REFRESH_INTERVAL=30
# 关闭 AUTO_START 后保留 HTTP 连接；显式设置 stdio 仍使用本地自动进程。
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp

# LangSmith 追踪配置；默认关闭，启用后填写对应 API Key。
# endpoint 应匹配账号所属区域；下面保留输入输出以便观察完整检索链路。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=OncallAgent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
COMPACTOR_MODEL=qwen3.8-flash
CHAT_HISTORY_ESTIMATED_TOKENS=64000
AIOPS_REPLAN_STEP_MAX_CHARS=24000
# For a 1M-token chat model, example long-context values are 256000 / 160000 / 96000.
COMPACTOR_HIGH_WATERMARK_TOKENS=48000
COMPACTOR_TARGET_WATERMARK_TOKENS=18000
COMPACTOR_TOOL_CHAR_THRESHOLD=45000

# Empty uses a random signing key persisted in the local SQLite database.
ONCALL_JWT_SECRET=

# Long-term memory runtime settings.
LTM_ENABLED=false
LTM_VECTOR_ENABLED=false
LTM_PAID_CALLS_ENABLED=false
LTM_COLLECTION_NAME=oncall_long_term_incidents
LTM_DAILY_EMBEDDING_ITEM_BUDGET=0
LTM_RECALL_TOP_K=3
LTM_CANDIDATES_PER_ROUTE=10
LTM_CONTEXT_ESTIMATED_TOKENS=32768
LTM_RECALL_TIMEOUT_SECONDS=2


# M4 background extraction. Paid extraction requires positive input and output budgets.
LTM_AUTO_EXTRACT_ENABLED=false
LTM_EXTRACT_MODEL=qwen3.8-flash
LTM_EXTRACT_TIMEOUT_SECONDS=15
LTM_EXTRACT_INPUT_CHARS=6000
LTM_EXTRACT_OUTPUT_TOKENS=1000
LTM_WORKER_CONCURRENCY=1
LTM_JOB_LEASE_SECONDS=60
LTM_JOB_MAX_ATTEMPTS=2
LTM_DAILY_INPUT_TOKEN_BUDGET=0
LTM_DAILY_OUTPUT_TOKEN_BUDGET=0
